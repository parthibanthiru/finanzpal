# Copy this file to .env and fill in the values.
# Supabase → Project Settings → API (use a project in the EU / Frankfurt region)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Your Finanzpal chatbot backend (Node/Express).
# On a real phone, "localhost" is the phone itself – use your computer's LAN IP, e.g. http://192.168.0.23:3000
EXPO_PUBLIC_API_URL=http://192.168.0.23:3000

# The website (switch to https://finanzpal.de once the domain is connected). Ratgeber articles, the other calculators and the score methodology open here.
EXPO_PUBLIC_SITE_URL=https://finanzpal.netlify.app

# 1 = load comparison data live from {SITE_URL}/data/*.json (falls back to the copy built into
# the app). Leave at 0 while the site is behind the Netlify SSO gate.
EXPO_PUBLIC_DATA_LIVE=0
