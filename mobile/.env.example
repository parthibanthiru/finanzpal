# Copy this file to .env and fill in the values.
# Supabase project "Finanzpal" (Frankfurt). The publishable key is public by design — row level
# security in supabase/schema.sql protects the data. Never put the service-role key here.
EXPO_PUBLIC_SUPABASE_URL=https://xliitgcsiikzxppazbfa.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_CaMuP9DFbFbeTLf2J1SNTw_rXmuNPgb

# Chatbot backend. Default: the Supabase Edge Function "chat" (supabase/functions/chat) — a URL ending
# in /functions/v1 gets /chat appended; left empty, the app uses {SUPABASE_URL}/functions/v1/chat.
# Another server (e.g. a local Node/Express backend at http://192.168.0.23:3000) gets /api/chat appended;
# on a real phone use your computer's LAN IP, not "localhost".
EXPO_PUBLIC_API_URL=https://xliitgcsiikzxppazbfa.supabase.co/functions/v1

# The website (switch to https://finanzpal.de once the domain is connected). Ratgeber articles, the other calculators and the score methodology open here.
EXPO_PUBLIC_SITE_URL=https://finanzpal.netlify.app

# 1 = load comparison data live from {SITE_URL}/data/*.json (falls back to the copy built into
# the app). Leave at 0 while the site is behind the Netlify SSO gate.
EXPO_PUBLIC_DATA_LIVE=0
