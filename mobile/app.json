{
  "expo": {
    "name": "Finanzpal",
    "slug": "finanzpal",
    "scheme": "finanzpal",
    "version": "0.8.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "de.finanzpal.app",
      "supportsTablet": false,
      "usesAppleSignIn": true
    },
    "android": {
      "package": "de.finanzpal.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F2A3D"
      }
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0F2A3D"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "icon": "./assets/icon.png"
  }
}
